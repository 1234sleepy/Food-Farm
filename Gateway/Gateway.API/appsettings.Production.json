{
  //"Logging": {
  //  "LogLevel": {
  //    "Default": "Information",
  //    "Microsoft.AspNetCore": "Warning"
  //  }
  //}
  "ReverseProxy": {
    "Routes": {
      "ProductMicroService": {
        "ClusterId": "product-microservice",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/product-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/product-service"
          }
        ]
      },
      "OrderMicroService": {
        "ClusterId": "order-microservice",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/order-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/order-service"
          }
        ]
      },
      "CartMicroService": {
        "ClusterId": "cart-microservice",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/cart-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/cart-service"
          }
        ]
      },
      "AccountMicroService": {
        "ClusterId": "account-microservice",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/account-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/account-service"
          }
        ]
      }
    },
    "Clusters": {
      "product-microservice": {
        "Destinations": {
          "destiantion1": {
            "Address": "http://product-api:5010/"
          }
        }
      },
      "order-microservice": {
        "Destinations": {
          "destiantion1": {
            "Address": "http://order-api:5011/"
          }
        }
      },
      "cart-microservice": {
        "Destinations": {
          "destiantion1": {
            "Address": "http://cart-api:5012/"
          }
        }
      },
      "account-microservice": {
        "Destinations": {
          "destiantion1": {
            "Address": "http://account-api:5013/"
          }
        }
      }
    }
  }
}
